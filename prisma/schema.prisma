datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id                       String                 @id @default(uuid())
  email                    String                 @unique
  name                     String?
  plan                     String                 @default("FREE") // FREE, LITE, PRO, UNLIMITED
  paypalSubscriptionId     String?                @unique
  paypalSubscriptionStatus String? // ACTIVE, SUSPENDED, CANCELLED, EXPIRED
  tossCustomerKey          String?                @unique
  tossBillingKey           String?                @unique
  tossPaymentKey           String?                @unique
  tossLastOrderId          String?                @unique
  tossSubscriptionStatus   String? // PENDING, ACTIVE, PAST_DUE, CANCELED
  tossNextBillingAt        DateTime?
  tossLastPaidAt           DateTime?
  tossCanceledAt           DateTime?
  nicepayBid               String?                @unique
  nicepaySubscriptionStatus String? // PENDING, ACTIVE, PAST_DUE, CANCELED
  nicepayNextBillingAt     DateTime?
  nicepayLastPaidAt        DateTime?
  nicepayCanceledAt        DateTime?
  nicepayLastOrderId       String?                @unique
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  brands                   Brand[]
  campaigns                Campaign[]
  posts                    Post[]
  templates                Template[]
  instagramAccount         InstagramAccount?
  editLogs                 UserEditLog[]
  summarizedPreferences    SummarizedPreference[]
  qualityScoreLogs         QualityScoreLog[]
  aiGenerationLogs         AiGenerationLog[]
}

model Brand {
  id                   String                @id @default(uuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  industry             String
  targetAudience       String
  toneOfVoice          String
  mainColor            String
  forbiddenWords       String
  ctaStyle             String
  websiteUrl           String?
  brandDna             String?
  editorPreferences    String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  campaigns            Campaign[]
  instagram            InstagramAccount?
  posts                Post[]
  editLogs             UserEditLog[]
  summarizedPreference SummarizedPreference?
}

model InstagramAccount {
  id                       String    @id @default(uuid())
  userId                   String    @unique
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId                  String    @unique
  brand                    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  instagramAccountId       String
  accessTokenEncrypted     String
  facebookPageId           String?
  pageAccessTokenEncrypted String?
  tokenExpiresAt           DateTime?
  username                 String?
  profilePictureUrl        String?
  connectionMethod         String    @default("manual") // oauth, manual, mock
  status                   String    @default("DISCONNECTED") // CONNECTED, DISCONNECTED
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model Campaign {
  id                         String           @id @default(uuid())
  userId                     String
  user                       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId                    String
  brand                      Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title                      String
  productName                String
  productDescription         String
  keyBenefits                String
  objective                  String
  slideCount                 Int
  status                     String           @default("draft") // draft, generated, pending_approval, scheduled, posted, failed
  agentReport                String?
  imageModel                 String?
  initialImageCount          Int              @default(0)
  regenerationImageCount     Int              @default(0)
  lastRegenerationImageModel String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  slides                     CarouselSlide[]
  posts                      Post[]
  qualityScoreLogs           QualityScoreLog[]
}

model CarouselSlide {
  id                 String   @id @default(uuid())
  campaignId         String
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  slideNumber        Int
  headline           String
  body               String
  designPrompt       String
  imageUrl           String?
  backgroundImageUrl String?
  fontPreset         String?
  textColor          String?
  headlineFontSize   Int?
  bodyFontSize       Int?
  editorDocument     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Post {
  id               String   @id @default(uuid())
  campaignId       String
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId          String
  brand            Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  caption          String
  hashtags         String // Comma-separated or space-separated
  scheduledAt      DateTime
  instagramMediaId String?
  status           String   @default("draft") // draft, pending_approval, scheduled, posted, failed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Template {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  document  String   // EditorialDocument JSON (text/image stripped)
  thumbnail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ErrorLog {
  id           String   @id @default(uuid())
  userId       String?
  actionName   String
  errorMessage String
  errorStack   String?
  contextData  String? // JSON stringified context
  createdAt    DateTime @default(now())
}

model AiGenerationLog {
  id               String   @id @default(uuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaignId       String?
  brandId          String?
  stepName         String
  provider         String
  status           String
  model            String?
  baseURL          String?
  keyFingerprint   String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  errorStatus      Int?
  errorCode        String?
  errorType        String?
  errorMessage     String?
  metadata         String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([stepName, status])
  @@index([model])
}

// ─── Intelligence Layer Models ────────────────────────────────────────────────

model CrawledPost {
  id                 String   @id @default(uuid())
  platform           String   // "instagram" | "threads" | "naver_blog" | "pinterest"
  sourceUrl          String   @unique
  crawledAt          DateTime @default(now())
  isCarousel         Boolean  @default(false)
  carouselConfidence Float?
  carouselType       String?  // "product_showcase" | "how_to" | "list" | "story" | "unknown"
  slideCount         Int?
  estimatedLikes     Int?
  estimatedComments  Int?
  headlinePosition   String?
  headlineLength     Int?
  emotionSignal      String?
  designStyle        String?
  colorPalette       String?  // JSON string: { dominant, accent }
  textDensity        String?  // "low" | "medium" | "high"
  trendKeywords      String?  // JSON string: string[]
  hashtags           String?  // JSON string: string[]
  embedding          Unsupported("vector(1536)")?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([platform, crawledAt])
  @@index([isCarousel])
}

model ViralCopyPattern {
  id                    String   @id @default(uuid())
  sourceType            String   // "url" | "image_url" | "crawled"
  sourcePlatform        String?
  analyzedAt            DateTime
  headlineStyle         String
  emotionalTrigger      String   // EmotionalIntent
  detectedHookPattern   String   // HookPatternId
  slideRole             String   // SlideRole
  layoutType            String
  copyTone              String
  extractedPatternNotes String
  engagementScore       Float    @default(0.0)
  usageCount            Int      @default(0)
  industry              String?  // IndustryCategory or null
  embedding             Unsupported("vector(1536)")?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([detectedHookPattern])
  @@index([industry])
  @@index([engagementScore])
}

model TrendSignal {
  id                  String   @id @default(uuid())
  platform            String   // "naver" | "instagram" | "pinterest" | "cross"
  keyword             String
  category            String?  // IndustryCategory or null
  phase               String   @default("emerging") // "emerging" | "rising" | "peak" | "declining"
  mentionCount        Int      @default(0)
  velocityScore       Float    @default(0.0)
  engagementProxy     Float    @default(0.0)
  associatedLayouts   String?  // JSON string: LayoutType[]
  associatedColors    String?  // JSON string: string[]
  associatedEmotions  String?  // JSON string: EmotionalIntent[]
  firstSeenAt         DateTime @default(now())
  lastSeenAt          DateTime @default(now())
  peakAt              DateTime?
  embedding           Unsupported("vector(1536)")?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([platform, keyword])
  @@index([phase, platform])
  @@index([velocityScore])
}

model UserEditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId String?
  slideId    String?
  eventType  String   // "headline_edit" | "body_edit" | "font_change" | "layout_change"
                      // | "color_change" | "image_replace" | "copy_rewrite" | "reset"
  editDelta  String?  // JSON: { beforeLength, afterLength } — NO raw text stored
  metadata   String?  // JSON: { fontPreset, hookPatternApplied, layoutType, intent, ... }
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([brandId])
}

model SummarizedPreference {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId                String   @unique
  brand                  Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  preferredHookPatterns  String?  // JSON: { pattern: HookPatternId, weight: number }[]
  preferredLayouts       String?  // JSON: { layout: LayoutType, weight: number }[]
  preferredEmotions      String?  // JSON: { emotion: EmotionalIntent, weight: number }[]
  preferredCopyTone      String?  // "short_punchy" | "emotional" | "informational" | "luxury"
  preferredColorStyle    String?  // "dark" | "bright" | "neutral"
  avoidPatterns          String?  // JSON: HookPatternId[]
  summary                String?  // 200-char Korean plain text injected into prompts
  embedding              Unsupported("vector(1536)")?
  compressedAt           DateTime @default(now())
  editLogCountAtCompress Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model QualityScoreLog {
  id                 String   @id @default(uuid())
  campaignId         String
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passed             Boolean
  score              Int
  narrativeFlowScore Int
  personaFitScore    Int
  hookPatternScore   Int
  issueCount         Int
  issuesJson         String?  // JSON: CopyQualityIssue[]
  hookPatternUsed    String?  // HookPatternId
  personaUsed        String?  // PersonaId
  industryUsed       String?  // IndustryCategory
  trendContextUsed   Boolean  @default(false)
  memoryContextUsed  Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
  @@index([score])
}
