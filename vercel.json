{
  "functions": {
    "app/api/youtube-automation/days/*/render/route.ts": {
      "memory": 3009
    },
    "app/api/cron/youtube-render/route.ts": {
      "memory": 3009
    },
    "app/api/shorts-lab/generate/route.ts": {
      "memory": 3009
    }
  },
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/blob-cleanup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/youtube-render",
      "schedule": "* * * * *"
    }
  ]
}
