# Database configuration (PostgreSQL)
# If you don't have a PostgreSQL database ready, set DATABASE_MOCK_FALLBACK=true
# and the application will use a local JSON file database (prisma/db.json) automatically!
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/instaagent?schema=public"
DATABASE_MOCK_FALLBACK=true

# AI Service Configuration
# Required for actual OpenAI content and image generation
OPENAI_API_KEY="your-openai-api-key-here"

# Instagram Integration Settings
# Set INSTAGRAM_MOCK_MODE=true to simulate Instagram API calls locally without Meta tokens
INSTAGRAM_MOCK_MODE=true
INSTAGRAM_ACCOUNT_ID="17841400000000000"
INSTAGRAM_ACCESS_TOKEN="mock_access_token_xyz123"
# Used to encrypt Instagram access tokens before database storage.
# Set a long random value in production and keep it stable across deploys.
INSTAGRAM_TOKEN_ENCRYPTION_KEY="replace-with-a-long-random-secret"

# Secret key for local mock authentication (Demo purposes)
# Feel free to change or input any email on the login screen
NEXT_PUBLIC_DEMO_USER_EMAIL="demo@instaagent.ai"
