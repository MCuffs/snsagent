# Database configuration (PostgreSQL)
# If you don't have a PostgreSQL database ready, set DATABASE_MOCK_FALLBACK=true
# and the application will use a local JSON file database (prisma/db.json) automatically!
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shuffla?schema=public"
# Use a direct connection URL for Prisma migrations when a pooler is used.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shuffla?schema=public"
DATABASE_MOCK_FALLBACK=true

# AI Service Configuration
# Brand URL analysis providers. Configure at least one provider for real analysis.
GEMINI_API_KEY="your-gemini-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"
PERPLEXITY_API_KEY="your-perplexity-api-key-here"
NAVER_CLIENT_ID="your-naver-client-id-here"
NAVER_CLIENT_SECRET="your-naver-client-secret-here"

# OpenAI is used by conversational Agent routes and card copy.
# Carousel images are sourced from Pexels only. Image generation fallbacks are disabled.
PEXELS_API_KEY=""
PEXELS_TIMEOUT_MS=2500
IMAGE_PROVIDER=pexels
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_BASE_URL=""
# Optional overrides: all text planning and copy generation default to GPT-5.5.
OPENAI_TEXT_MODEL="gpt-5.5"
OPENAI_COPY_MODEL="gpt-5.5"
BYTEDANCE_API_KEY=""
BYTEDANCE_BASE_URL="https://ark.ap-southeast.bytepluses.com/api/v3"
BYTEDANCE_VIDEO_MODEL="seedance-1-5-pro-250528"

# Instagram Integration Settings
# Set INSTAGRAM_MOCK_MODE=true to simulate Instagram API calls locally without Meta tokens
INSTAGRAM_MOCK_MODE=true
INSTAGRAM_ACCOUNT_ID="17841400000000000"
INSTAGRAM_ACCESS_TOKEN="mock_access_token_xyz123"
# Meta OAuth for real Instagram Business account connection
META_APP_ID=""
META_APP_SECRET=""
META_API_VERSION="v19.0"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth login
# Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Signs the application login session cookie. Required in production (32+ random characters).
SESSION_SECRET="replace-with-a-long-random-secret"

# Comma-separated administrator emails with super-user access.
SUPER_USER_EMAILS=""

# Signs the NicePay return verification tokens. Required in production (32+ random characters).
NICEPAY_RETURN_TOKEN_SECRET="replace-with-a-long-random-secret"

# Toss Payments automatic billing
# Automatic billing requires a billing MID contract. Use API individual integration keys.
# The browser SDK uses the client key; only server routes may read the secret key.
NEXT_PUBLIC_TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""

# NicePay automatic billing (alternative to Toss for domestic card payments)
# Get keys from NicePay merchant dashboard.
# NEXT_PUBLIC_NICEPAY_CLIENT_KEY is exposed to the browser (R2_ prefix key).
# NICEPAY_CLIENT_KEY and NICEPAY_SECRET_KEY are server-only.
NEXT_PUBLIC_NICEPAY_CLIENT_KEY=""
NICEPAY_CLIENT_KEY=""
NICEPAY_SECRET_KEY=""
# Protects /api/nicepay/webhook. Configure NicePay webhook URL as /api/nicepay/webhook?secret=<NICEPAY_WEBHOOK_SECRET>.
NICEPAY_WEBHOOK_SECRET=""
# Enable URL query parameter secret verification for webhooks that don't support custom headers (e.g., NicePay).
# Set to 'true' only if your webhook provider cannot send Authorization: Bearer headers.
# Default: false (Bearer header only — more secure, prevents secret leakage in logs)
WEBHOOK_ALLOW_QUERY_SECRET="false"

# PayPal Subscription for international customers
# Run scripts/paypal-setup.mjs to create monthly KRW plans and the signed webhook.
PAYPAL_SANDBOX=true
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
# Browser SDK can use NEXT_PUBLIC_PAYPAL_CLIENT_ID, or the server PAYPAL_CLIENT_ID fallback.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
# PayPal plan IDs can be provided as NEXT_PUBLIC_* or server-only PAYPAL_PLAN_* values.
PAYPAL_PLAN_LITE=""
PAYPAL_PLAN_PRO=""
PAYPAL_PLAN_UNLIMITED=""
NEXT_PUBLIC_PAYPAL_PLAN_LITE=""
NEXT_PUBLIC_PAYPAL_PLAN_PRO=""
NEXT_PUBLIC_PAYPAL_PLAN_UNLIMITED=""

# Polar checkout links and product IDs
POLAR_CHECKOUT_YOUTUBE_PROMO=""
POLAR_CHECKOUT_PRO=""
POLAR_CHECKOUT_UNLIMITED=""
POLAR_PRODUCT_YOUTUBE_PROMO=""
POLAR_PRODUCT_PRO=""
POLAR_PRODUCT_UNLIMITED=""
NEXT_PUBLIC_POLAR_PRODUCT_YOUTUBE_PROMO=""
NEXT_PUBLIC_POLAR_PRODUCT_PRO=""
NEXT_PUBLIC_POLAR_PRODUCT_UNLIMITED=""

# YouTube Shorts renderer limits
YOUTUBE_RENDER_TOTAL_TIMEOUT_MS="480000"
YOUTUBE_RENDER_DOWNLOAD_CONCURRENCY="3"
YOUTUBE_RENDER_DOWNLOAD_TIMEOUT_MS="12000"
YOUTUBE_RENDER_DOWNLOAD_IDLE_TIMEOUT_MS="6000"
YOUTUBE_RENDER_TTS_CONCURRENCY="3"
YOUTUBE_RENDER_FFMPEG_CONCURRENCY="2"
YOUTUBE_RENDER_NORMALIZE_TIMEOUT_MS="90000"
YOUTUBE_RENDER_FINAL_TIMEOUT_MS="240000"
YOUTUBE_RENDER_CLIP_ATTEMPTS="3"

# Used to encrypt Instagram access tokens before database storage.
# Set a long random value in production and keep it stable across deploys.
INSTAGRAM_TOKEN_ENCRYPTION_KEY="replace-with-a-long-random-secret"

# Vercel Blob Storage (image upload)
# Required in production. Get from Vercel Dashboard → Storage → Blob → Create store
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# Protects /api/cron/publish, /api/cron/billing, and /api/cron/retention.
# Invoke cron routes with Authorization: Bearer <CRON_SECRET>; do not pass secrets in URLs.
CRON_SECRET=""

# Inngest (background jobs — trend crawling, memory compression)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Carousel AI detection (optional — uses GPT-4o Vision for borderline cases)
# CAROUSEL_AI_DETECTION=true

# Intelligence context injection into generation pipeline (Phase 2+)
# INTELLIGENCE_CONTEXT=true

# Secret key for local mock authentication (Demo purposes)
# Feel free to change or input any email on the login screen
NEXT_PUBLIC_DEMO_USER_EMAIL="demo@shuffla.ai"

# Enables FastSpring checkout UI only for this tester account in the browser.
NEXT_PUBLIC_FASTSPRING_TESTER_EMAIL=""
