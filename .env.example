# Database configuration (PostgreSQL)
# If you don't have a PostgreSQL database ready, set DATABASE_MOCK_FALLBACK=true
# and the application will use a local JSON file database (prisma/db.json) automatically!
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shuffla?schema=public"
# Use a direct connection URL for Prisma migrations when a pooler is used.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shuffla?schema=public"
DATABASE_MOCK_FALLBACK=true

# AI Service Configuration
# Brand URL analysis providers. Configure at least one provider for real analysis.
GEMINI_API_KEY="your-gemini-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"
PERPLEXITY_API_KEY="your-perplexity-api-key-here"
NAVER_CLIENT_ID="your-naver-client-id-here"
NAVER_CLIENT_SECRET="your-naver-client-secret-here"

# OpenAI is used by conversational Agent routes, card copy, and optional image generation.
# The billable CMS image pipeline is fixed to gpt-image-1 in source for predictable unit economics.
IMAGE_PROVIDER=mock
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_BASE_URL=""
BYTEDANCE_API_KEY=""

# Instagram Integration Settings
# Set INSTAGRAM_MOCK_MODE=true to simulate Instagram API calls locally without Meta tokens
INSTAGRAM_MOCK_MODE=true
INSTAGRAM_ACCOUNT_ID="17841400000000000"
INSTAGRAM_ACCESS_TOKEN="mock_access_token_xyz123"
# Meta OAuth for real Instagram Business account connection
META_APP_ID=""
META_APP_SECRET=""
META_API_VERSION="v19.0"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth login
# Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Signs the application login session cookie. Required in production (32+ random characters).
SESSION_SECRET="replace-with-a-long-random-secret"

# PayPal Subscription
# Run scripts/paypal-setup.mjs to create KRW plans: Single (3,000/1), Creator (19,000/20), Studio (45,000/30).
# Recreate plan IDs when changing pricing; displayed prices must match PayPal billing plans.
PAYPAL_SANDBOX=true
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
NEXT_PUBLIC_PAYPAL_PLAN_LITE=""
NEXT_PUBLIC_PAYPAL_PLAN_PRO=""
NEXT_PUBLIC_PAYPAL_PLAN_UNLIMITED=""

# Used to encrypt Instagram access tokens before database storage.
# Set a long random value in production and keep it stable across deploys.
INSTAGRAM_TOKEN_ENCRYPTION_KEY="replace-with-a-long-random-secret"

# Vercel Blob Storage (image upload)
# Required in production. Get from Vercel Dashboard → Storage → Blob → Create store
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# Protects /api/cron/publish. Configure the deployment scheduler to send this secret.
CRON_SECRET=""

# Secret key for local mock authentication (Demo purposes)
# Feel free to change or input any email on the login screen
NEXT_PUBLIC_DEMO_USER_EMAIL="demo@shuffla.ai"
